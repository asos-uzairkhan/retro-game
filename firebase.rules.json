{
  "rules": {
    ".read": false,
    ".write": false,
    "feedback": {
      ".read": false,
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['message', 'createdAt'])",
        "message": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "games": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('meta/adminUid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('meta/adminUid').val() === auth.uid))",

        "meta": {
          ".write": "auth != null && data.child('adminUid').val() === auth.uid",
          "phase": {
            ".write": "auth != null && (root.child('games/' + $code + '/meta/adminUid').val() === auth.uid || (data.val() === 'voting' && newData.val() === 'reveal'))",
            ".validate": "newData.isString() && (newData.val() === 'joining' || newData.val() === 'gameplay' || newData.val() === 'reflection' || newData.val() === 'voting' || newData.val() === 'reveal' || newData.val() === 'end')"
          },
          "phaseStartedAt": {
            ".write": "auth != null"
          },
          "gameplayTimerMin": {
            ".validate": "newData.isNumber() && (newData.val() === -1 || (newData.val() >= 1 && newData.val() <= 240))"
          },
          "gameplayExtraSec": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
          }
        },

        "secrets": {
          ".write": "auth != null && root.child('games/' + $code + '/meta/adminUid').val() === auth.uid"
        },

        "players": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('games/' + $code + '/meta/adminUid').val() === auth.uid)",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "hints": {
              "$idx": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
              }
            },
            "optedOut": {
              ".validate": "newData.isBoolean()"
            },
            "hintsPending": {
              ".validate": "newData.isBoolean()"
            }
          }
        },

        "rooms": {
          "$roomId": {
            "occupantId": {
              ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
            },
            "solved": {
              ".write": "auth != null && data.val() !== true && root.child('games/' + $code + '/rooms/' + $roomId + '/occupantId').val() === auth.uid"
            },
            "solvedBy": {
              ".write": "auth != null && root.child('games/' + $code + '/rooms/' + $roomId + '/occupantId').val() === auth.uid"
            },
            "answer": {
              ".write": "auth != null && root.child('games/' + $code + '/rooms/' + $roomId + '/occupantId').val() === auth.uid",
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
            },
            "hintIndex": {
              ".write": "auth != null && root.child('games/' + $code + '/meta/adminUid').val() === auth.uid",
              ".validate": "newData.isNumber() || newData.val() === null"
            },
            "action": {
              ".write": "auth != null && root.child('games/' + $code + '/meta/adminUid').val() === auth.uid",
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "pings": {
              ".write": "auth != null && root.child('games/' + $code + '/rooms/' + $roomId + '/occupantId').val() === auth.uid",
              "$uid": {
                ".validate": "newData.isBoolean()"
              }
            },
            "reactions": {
              "$uid": {
                ".write": "auth != null && $uid === auth.uid",
                "$key": {
                  ".validate": "($key === 'agree' || $key === 'metoo' || $key === 'love' || $key === 'celebrate' ||$key === 'funny' || $key === 'think') && newData.val() === true"
                }
              }
            }
          }
        },

        "cluesFound": {
          "$hintIndex": {
            ".write": "auth != null && root.child('games/' + $code + '/players/' + auth.uid).exists()",
            ".validate": "newData.isBoolean()"
          }
        },

        "votes": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && !data.exists() && root.child('games/' + $code + '/meta/phase').val() === 'voting'",
            ".validate": "newData.isString()"
          }
        },

        "groupVotes": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && root.child('games/' + $code + '/meta/phase').val() === 'reflection'",
            "$key": {
              ".validate": "$key.length <= 30 && newData.val() === true"
            }
          }
        }
      }
    }
  }
}
